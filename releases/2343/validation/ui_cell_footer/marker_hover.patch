+const fs=require('fs'),vm=require('vm'),assert=require('assert');const src=fs.readFileSync('dist/app.js','utf8');const fn=src.slice(src.indexOf('function cellFooter('),src.indexOf('function bindCellHover('));const ctx={day:20,num:n=>n.toLocaleString('en-US'),pct:n=>(n>0?'+':'')+(n*100).toFixed(2)+'%',signColor:n=>n>0?'red':n<0?'green':'gray'};vm.createContext(ctx);vm.runInContext(fn,ctx);let checks=0;for(const mode of ['all','recent'])for(const N of [10,20,30,60,120]){const d=JSON.parse(fs.readFileSync(N===60?`fixtures/${mode}.json`:`dist/prior/${N}/${mode}.json`));for(const c of d.curves)for(const L of [0,10,20,30,60,120,250]){ctx.day=L;const out=ctx.cellFooter(c,true);if(c.empty||c.p10[L]===null||c.p90[L]===null)assert.equal(out,'暂无区间');else{assert(out.includes(ctx.pct(c.p90[L])));assert(out.includes(ctx.pct(c.p10[L])));}assert(ctx.cellFooter(c,false).includes('条'));checks++;}}assert.equal(ctx.cellFooter({empty:false,p90:[],p10:[]},true),'暂无区间');console.log('PASS',checks,'vertical-marker footer checks: five N, both ranges/anchors, seven marker days; missing never zero');
